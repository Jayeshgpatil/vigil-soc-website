# Copy to .env (or set these in your host's dashboard) before deploying.

# --- required in production -------------------------------------------------

# Signs session tokens. Without it the server generates one into
# server/data/.secret, which is fine locally but wrong for a real deployment
# where the filesystem may be ephemeral or shared across instances.
#   openssl rand -hex 48
VGIL_SECRET=

# Enables static-asset caching and, importantly, turns demo mode OFF.
NODE_ENV=production

# --- optional ---------------------------------------------------------------

# Listen port. Most hosts inject this themselves.
PORT=3000

# Where the SQLite file lives. Point this at a mounted persistent volume;
# on an ephemeral filesystem the database is wiped on every restart.
VGIL_DB=/data/vgil.db

# Seed the shared demo accounts and show their credentials on the sign-in page.
# Defaults to off whenever NODE_ENV=production. Only set this to 1 if the
# deployment is a public showcase and you accept that anyone can sign in
# as an administrator.
VGIL_DEMO=0

# Allow self-service sign-up. Set to 0 to lock the deployment to accounts
# an administrator has already created.
VGIL_REGISTRATION=1

# Promote the very first account created on an empty instance to admin.
# Leave on for the initial deploy, then set to 0 once you have your account.
VGIL_BOOTSTRAP_ADMIN=1

# Multiplies every rate-limit budget. Leave at 1 in production.
VGIL_RATE_FACTOR=1
